# Application Configuration
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/task_management_db?schema=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration (UI local Vite port)
CORS_ORIGIN=http://localhost:3000

# Public app URL used in password-reset email links (must match the live UI origin).
APP_URL=http://localhost:3000

# Resend (required for real reset emails). Free tier is enough for demos.
# 1) Create API key at https://resend.com
# 2) Uncomment and set RESEND_API_KEY
# 3) For local tests you can keep EMAIL_FROM as onboarding@resend.dev (Resend test sender)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Task Management <onboarding@resend.dev>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

