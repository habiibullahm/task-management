# Application Configuration
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/task_management_db?schema=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration (UI local Vite port)
CORS_ORIGIN=http://localhost:3000

# Public app URL used in password-reset email links (must match the live UI origin).
APP_URL=http://localhost:3000

# --- Email (password reset) ---
# Local: Gmail SMTP (App Password) works well.
# Render/production: set RESEND_API_KEY (Gmail SMTP is often blocked). Production prefers Resend when set.
# 1) Google Account → Security → 2-Step Verification → App passwords
# 2) Create an app password and paste it as SMTP_PASS (16 chars; quotes OK if spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=Task Management <you@gmail.com>

# Resend (recommended on Render). Free tier: from onboarding@resend.dev; can only send to your Resend account email unless domain verified.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Task Management <onboarding@resend.dev>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

